# Server Configuration
PORT=8081
CLIENT_URL=http://localhost:3000
DOMAIN_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1
FORMAT=LN
BRANCH_LIMIT=5

# Database Connection
urlDB=mongodb://127.0.0.1:27017/clientmark

# Authentication & Security Secrets
# CREDENTIALS_ENCRYPTION_KEY (or CREDENTIAL_ENCRYPTION_KEY) must be a 64-char hex string or 44-char base64 string (32 bytes) for AES-256-GCM
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=your_jwt_secret_key_change_in_production
OTP_HMAC_SECRET=your_dedicated_hmac_secret_for_otp_hashing
PORTAL_JWT_SECRET=your_dedicated_secret_for_client_portal_tokens

# Portal Security & Feature Flags
PORTAL_LEGACY_SLUG_ENABLED=false
TENANT_DAILY_OTP_CAP=200

# Socket.IO Realtime Security
SOCKET_MAX_PER_USER=5
SOCKET_MAX_PER_DEMO_USER=200

# Storage Driver & File Upload Security
# STORAGE_DRIVER (or STORAGE_TYPE) options: 'local' | 's3' | 'b2' (defaults to 'local')
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=25
# Setting LEGACY_PUBLIC_UPLOADS=true is strongly discouraged; keep false for private authenticated file serving
LEGACY_PUBLIC_UPLOADS=false

# S3 / Backblaze B2 Object Storage (Required if STORAGE_DRIVER is 's3' or 'b2')
S3_BUCKET=your_storage_bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Dodo Payments (Primary Merchant of Record Billing)
# Retrieve your API Key and Webhook Signing Secret from https://app.dodopayments.com/developer
DODO_PAYMENTS_API_KEY=your_dodo_api_key_test_or_live
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_signing_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional: Pre-configured Dodo Product IDs (configured in Dodo Dashboard)
DODO_PRODUCT_STARTER_MONTHLY=pdt_starter_monthly_placeholder
DODO_PRODUCT_STARTER_YEARLY=pdt_starter_yearly_placeholder
DODO_PRODUCT_PROFESSIONAL_MONTHLY=pdt_professional_monthly_placeholder
DODO_PRODUCT_PROFESSIONAL_YEARLY=pdt_professional_yearly_placeholder
DODO_PRODUCT_ENTERPRISE_MONTHLY=pdt_enterprise_monthly_placeholder
DODO_PRODUCT_ENTERPRISE_YEARLY=pdt_enterprise_yearly_placeholder

# Stripe Billing Configuration (Supported Alternative)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Razorpay Configuration (Legacy fallback, default false)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder

# Background Jobs & Subscription Lifecycle
GRACE_DAYS=5
DEMO_RESET_CRON=0 */6 * * *

# Platform SMTP Configuration (Used for password resets and system welcome emails)
PLATFORM_SMTP_HOST=smtp.gmail.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=support@clientmark.app
PLATFORM_SMTP_PASS=app_password_here
PLATFORM_EMAIL_FROM="Clientmark Support <support@clientmark.app>"

# Google Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key
